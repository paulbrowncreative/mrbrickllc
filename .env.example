# Quote form → email (netlify/functions/lead.mjs). Set these in
# Netlify → Site configuration → Environment variables (scope: Functions),
# then redeploy. Never commit real values; .env is git-ignored.

# SECRET. Resend → API Keys → Create API key (permission: Sending access).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where leads go. Comma-separate several addresses.
LEAD_TO_EMAIL=mrbrickmarketing@gmail.com,mrbrickdesignco@gmail.com,paulbrowncreative@gmail.com

# Must be on a domain verified in Resend → Domains.
RESEND_FROM_EMAIL="Mr. Brick Website <leads@mrbrickllc.com>"
